# ============================================================
#  TooManyBots Fun - Arquivo de Exemplo de Variáveis de Ambiente
#  Copie este arquivo para .env na raiz do projeto:
#    copy .env.example .env
# ============================================================

# ------------------------------------------------------------
#  1. PROVEDORES DE INTELIGÊNCIA ARTIFICIAL (LLM)
#  Preencha a chave correspondente ao provedor escolhido.
# ------------------------------------------------------------

# OpenRouter (Recomendado - Acesso a DeepSeek, Claude, Llama 3, Gemini)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek (API Oficial - Baixo custo e altíssima performance)
# Obtenha sua chave em: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI (Modelos GPT-4o e GPT-4o-mini)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Zen Proxy (Proxy local OpenCode Zen / TooManyBots na porta 20128)
ZEN_API_KEY=

# Ollama (Modelos locais - 100% gratuito e offline em localhost:11434)
# Opcional, a maioria das instalações locais não requer chave.
OLLAMA_API_KEY=

# LM Studio (Modelos locais com interface gráfica em localhost:1234)
# Opcional.
LMSTUDIO_API_KEY=

# ------------------------------------------------------------
#  2. MODO ECONÔMICO & CONTROLE DE REDE
# ------------------------------------------------------------

# Desativa chamadas externas para IA e força Modo Econômico (0 = desativado, 1 = ativado)
# No modo econômico o bot responde com templates offline instantâneos.
FUN_DISABLE_LIVE_LLM=0

# Exibe mensagens de depuração ao carregar arquivos .env (0 = não, 1 = sim)
DEBUG_ENV=0

# ------------------------------------------------------------
#  3. ARMAZENAMENTO & SESSÃO DO WHATSAPP
# ------------------------------------------------------------

# Diretório customizado de dados e banco de dados SQLite (padrão: data/fun)
# TMB_DATA_DIR=./data/fun
